<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee" version="4.0">

    <servlet>
        <servlet-name>AuditObjectServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.AuditObjectServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AuditObjectServlet</servlet-name>
        <url-pattern>/objects</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ConsumptionRecordServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.ConsumptionRecordServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ConsumptionRecordServlet</servlet-name>
        <url-pattern>/records</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>EnergyAuditServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.EnergyAuditServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EnergyAuditServlet</servlet-name>
        <url-pattern>/audits</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>MeasureServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.MeasureServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MeasureServlet</servlet-name>
        <url-pattern>/measures</url-pattern>
    </servlet-mapping>

</web-app>